import sys
import signal
import logging
from subprocess import Popen
from typing import List, Optional, Tuple, Dict
from contextlib import contextmanager

from PyQt5.QtWidgets import (QMainWindow, QApplication, QCheckBox, 
                            QDoubleSpinBox, QMessageBox)
from PyQt5.QtCore import QRegExp
from OPTgui import Ui_MainWindow

import half_linac.setup as st

class OptimizationWindow(QMainWindow, Ui_MainWindow):
    """Main window for optimization control application."""
    
    def __init__(self):
        super().__init__()
        self.setupUi(self)
        self.subprocesses: List[Popen] = []
        self._ui_cache: Dict[str, List] = {}  # UI元素缓存
        
        self._init_ui_elements()
        self._setup_signal_connections()
        self._set_default_values()
    
    def _init_ui_elements(self):
        """Initialize UI elements with meaningful names."""
        self.start_opt_button = self.pushButton_7
        self.quad_select_all = self.checkBox_2
        self.kick_select_all = self.checkBox
        self.quad_minus_set = self.pushButton_5
        self.quad_plus_set = self.pushButton_6
        self.kick_minus_set = self.pushButton_9
        self.kick_plus_set = self.pushButton_10
        self.quad_minus_value = self.doubleSpinBox_121
        self.quad_plus_value = self.doubleSpinBox_122
        self.kick_minus_value = self.doubleSpinBox
        self.kick_plus_value = self.doubleSpinBox_2
    
    def _setup_signal_connections(self):
        """Connect UI signals to slots."""
        self.start_opt_button.clicked.connect(self.start_optimization)
        
        # Quadrupole controls
        self.quad_select_all.clicked.connect(
            lambda: self.toggle_all_selection(self.quad_select_all.isChecked(), 'Q'))
        self.quad_minus_set.clicked.connect(
            lambda: self.set_all_values(self.quad_minus_value.value(), 'Q.*.minus.*'))
        self.quad_plus_set.clicked.connect(
            lambda: self.set_all_values(self.quad_plus_value.value(), 'Q.*.plus.*'))
        
        # Kicker controls
        self.kick_select_all.clicked.connect(
            lambda: self.toggle_all_selection(self.kick_select_all.isChecked(), 'C'))
        self.kick_minus_set.clicked.connect(
            lambda: self.set_all_values(self.kick_minus_value.value(), 'C.*.minus.*'))
        self.kick_plus_set.clicked.connect(
            lambda: self.set_all_values(self.kick_plus_value.value(), 'C.*.plus.*'))
    
    def _set_default_values(self):
        """Set default values for optimization parameters."""
        self.step_lineEdit.setText('0.1')
        self.iter_lineEdit.setText('1')
        self.noise_lineEdit.setText('0')
        self.interval_lineEdit.setText('8')
    
    def _get_cached_children(self, widget_type, pattern: Optional[str] = None):
        """Cache UI elements lookup results for better performance."""
        cache_key = f"{widget_type.__name__}_{pattern if pattern else 'all'}"
        if cache_key not in self._ui_cache:
            if pattern:
                self._ui_cache[cache_key] = self.findChildren(widget_type, QRegExp(pattern))
            else:
                self._ui_cache[cache_key] = self.findChildren(widget_type)
        return self._ui_cache[cache_key]
    
    def toggle_all_selection(self, state: bool, prefix: str):
        """Toggle selection of all checkboxes with given prefix."""
        checkboxes = self._get_cached_children(QCheckBox)
        relative_checkboxes = [cb for cb in checkboxes if prefix in cb.text()]
        
        for checkbox in relative_checkboxes:
            checkbox.setChecked(state)
    
    def set_all_values(self, value: float, pattern: str):
        """Set all matching spinboxes to given value."""
        spinboxes = self._get_cached_children(QDoubleSpinBox, pattern)
        for spinbox in spinboxes:
            spinbox.setValue(value)
    
    def find_knobs(self) -> Tuple[List[str], List[float], List[float]]:
        """Find all selected knobs and their values."""
        knobs_list = []
        knobs_minus = []
        knobs_plus = []

        used_knobs = [cb.text() for cb in self._get_cached_children(QCheckBox) if cb.isChecked()]
        all_range_spinboxes = self._get_cached_children(QDoubleSpinBox, "range.*")

        # Process quadrupole knobs
        filtered_quad = [s for s in used_knobs if 'Q' in s]
        if filtered_quad:
            quad_minus, quad_plus = self._get_ordered_values(filtered_quad, all_range_spinboxes)
            knobs_list.extend(filtered_quad)
            knobs_minus.extend(quad_minus)
            knobs_plus.extend(quad_plus)

        # Process kicker knobs
        filtered_kick = [s for s in used_knobs if 'C' in s]
        if filtered_kick:
            kick_minus, kick_plus = self._get_ordered_values(filtered_kick, all_range_spinboxes)
            knobs_list.extend(filtered_kick)
            knobs_minus.extend(kick_minus)
            knobs_plus.extend(kick_plus)
        
        return knobs_list, knobs_minus, knobs_plus
    
    def _get_ordered_values(self, basis_list: List[str], spinboxes: List[QDoubleSpinBox]) -> Tuple[List[float], List[float]]:
        """Get values in the order of basis_list."""
        values_minus = [None] * len(basis_list)
        values_plus = [None] * len(basis_list)
        
        # Create mapping for faster lookup
        spinbox_map = {}
        for spinbox in spinboxes:
            name = spinbox.objectName()
            for basis in basis_list:
                if basis in name:
                    key = 'minus' if 'minus' in name else 'plus'
                    spinbox_map.setdefault(basis, {})[key] = spinbox.value()
                    break
        
        # Fill results in order
        for idx, basis in enumerate(basis_list):
            if basis in spinbox_map:
                values_minus[idx] = spinbox_map[basis].get('minus')
                values_plus[idx] = spinbox_map[basis].get('plus')
        
        return values_minus, values_plus
    
    def get_objectives(self) -> Tuple[List[str], List[str], List[str], List[str]]:
        """Get optimization objectives from UI."""
        obj_pvname = [self.obj1_pvname.text(), self.obj2_pvname.text(), self.obj3_pvname.text()]
        obj_weight = [self.obj1_weight.text(), self.obj2_weight.text(), self.obj3_weight.text()]
        obj_samples = [self.obj1_samples.text(), self.obj2_samples.text(), self.obj3_samples.text()]
        obj_math = [self.obj1_math.currentText(), self.obj2_math.currentText(), self.obj3_math.currentText()]

        # Filter out empty objectives
        valid_indices = [i for i, pv in enumerate(obj_pvname) if pv]
        return (
            [obj_pvname[i] for i in valid_indices],
            [obj_weight[i] for i in valid_indices],
            [obj_samples[i] for i in valid_indices],
            [obj_math[i] for i in valid_indices]
        )
    
    def start_optimization(self):
        """Start optimization process with validation."""
        if not self._validate_inputs():
            QMessageBox.warning(self, "Invalid Input", "Please check your input parameters")
            return
        
        try:
            knobs_list, knobs_minus, knobs_plus = self.find_knobs()
            obj_pvname, obj_weight, obj_samples, obj_math = self.get_objectives()
            
            cmd = self._build_command(
                knobs_list, 
                knobs_minus, 
                knobs_plus,
                obj_pvname,
                obj_weight,
                obj_samples,
                obj_math
            )
            
            self._run_command(cmd)
            QMessageBox.information(self, "Success", "Optimization started successfully")
            
        except Exception as e:
            logging.error(f"Optimization failed: {e}")
            QMessageBox.critical(self, "Error", f"Failed to start optimization: {str(e)}")
    
    def _validate_inputs(self) -> bool:
        """Validate user inputs before starting optimization."""
        try:
            knobs_list, _, _ = self.find_knobs()
            if not knobs_list:
                return False
                
            step = float(self.step_lineEdit.text())
            if step <= 0:
                return False
                
            iterations = int(self.iter_lineEdit.text())
            if iterations <= 0:
                return False
                
            return True
        except ValueError:
            return False
    
    def _build_command(self, knobs_list, knobs_minus, knobs_plus, 
                      obj_pvname, obj_weight, obj_samples, obj_math) -> List[str]:
        """Build command list for optimization."""
        return [
            "python3", "RCDSopt.py",
            "start_opt",
            ",".join(knobs_list),
            ",".join(str(v) for v in knobs_minus),
            ",".join(str(v) for v in knobs_plus),
            self.step_lineEdit.text(),
            self.iter_lineEdit.text(),
            self.noise_lineEdit.text(),
            ",".join(obj_pvname),
            ",".join(obj_weight),
            ",".join(obj_samples),
            ",".join(obj_math)
        ]
    
    def _run_command(self, cmd: List[str]):
        """Run optimization command in subprocess."""
        kwargs = {"start_new_session": True}
        proc = Popen(
            cmd,
            cwd=st.rootpath + "/src/optimization/RCDS",
            shell=False,
            **kwargs
        )
        self.subprocesses.append(proc)
    
    def stop_optimization(self):
        """Stop all running optimization processes."""
        for proc in self.subprocesses[:]:  # Iterate over a copy
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                try:
                    proc.kill()
                except Exception as e:
                    logging.warning(f"Failed to kill process: {e}")
            except Exception as e:
                logging.warning(f"Error stopping process: {e}")
            finally:
                if proc in self.subprocesses:
                    self.subprocesses.remove(proc)
    
    def closeEvent(self, event):
        """Handle window close event."""
        self.stop_optimization()
        event.accept()

if __name__ == '__main__':
    logging.basicConfig(level=logging.INFO)
    app = QApplication(sys.argv)
    window = OptimizationWindow()
    window.show()
    sys.exit(app.exec_())
