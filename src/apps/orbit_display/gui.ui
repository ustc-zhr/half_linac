  <property name="styleSheet">
   <string notr="true">/* 基础背景 */
QMainWindow, QWidget#centralwidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

/* 左侧控制面板 */
QFrame {
    background-color: #242437;
    border-right: 1px solid #45475a;
    border-radius: 0px;
}

/* 按钮统一：科技蓝方案 */
QPushButton {
    background-color: #3e5f7a;
    border: 1px solid #589bcf;
    border-radius: 4px;
    color: white;
    padding: 5px;
    font-weight: bold;
	 font-size: 14px;
}

QPushButton:hover {
    background-color: #4a7a9d;
}

/* 输入框：琥珀色高亮（延续之前的风格） */
QLineEdit {
    background-color: #181825;
    border: 1px solid #fab387;
    border-radius: 3px;
    color: #f9e2af;
    padding: 2px;
}

/* 绘图控件容器（虽然绘图背景由 Matplotlib 控制，但边框可以统一） */
MplWidget {
    border: 1px solid #313244;
    background-color: #000000;
}

/* 标签文字 */
QLabel {
    color: #bac2de;
    font-size: 12px;
	font-weight: bold;
}

QRadioButton {
    color: #cdd6f4; /* 未选中时的文字颜色 */
    font-weight: normal;
    spacing: 8px;   /* 文字与圆圈之间的间距 */
}

/* 3. 修改指示器（圆圈）的样式 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 9px; /* 圆角半径为宽的一半，确保是圆形 */
    background-color: #313244;
}

/* 4. 选中时的指示器样式 */
QRadioButton::indicator:checked {
    background-color: #a6e3a1; /* 选中时内部填充为绿色 */
    border: 2px solid #cdd6f4;  /* 亮色边框 */
}</string>
