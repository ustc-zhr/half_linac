{
  "schema_version": "2.0",
  "machine": {
    "name": "IRFEL",
    "facility": "IRFEL",
    "description": "IRFEL control-room PV library for online acquisition and knob scan"
  },
  "defaults": {
    "acquisition": {
      "shot_interval_sec": 0.2,
      "sample_count": 200,
      "timeout_sec": 1.0,
      "mode": "poll"
    },
    "scan": {
      "settle_mode": "fixed_delay",
      "settle_delay_sec": 0.5,
      "sample_count_per_step": 20,
      "restore_initial_value": true,
      "max_wait_sec": 3.0
    },
    "storage": {
      "format": "parquet",
      "save_raw_data": true,
      "save_analysis_summary": true
    },
    "safety": {
      "confirm_before_write": true,
      "abort_on_disconnection": true
    }
  },
  "groups": [
    {
      "id": "steering_x",
      "label": "Steering X",
      "kind": "knob",
      "color": "#c84c09",
      "order": 10
    },
    {
      "id": "steering_y",
      "label": "Steering Y",
      "kind": "knob",
      "color": "#2a6f97",
      "order": 20
    },
    {
      "id": "solenoid",
      "label": "Solenoid",
      "kind": "knob",
      "color": "#5b8c5a",
      "order": 30
    },
    {
      "id": "ct",
      "label": "CT",
      "kind": "object",
      "color": "#8d6a9f",
      "order": 40
    },
    {
      "id": "radiation",
      "label": "Radiation",
      "kind": "object",
      "color": "#cc5803",
      "order": 50
    },
    {
      "id": "bpm_x",
      "label": "BPM X",
      "kind": "object",
      "color": "#20639b",
      "order": 60
    },
    {
      "id": "bpm_y",
      "label": "BPM Y",
      "kind": "object",
      "color": "#3caea3",
      "order": 70
    }
  ],
  "knobs": [
    {
      "id": "hc01_current",
      "name": "HC01",
      "group": "steering_x",
      "write_pv": "IRFEL:PS:HC01:current:ao",
      "readback_pv": "IRFEL:PS:HC01:current:ai",
      "unit": "A",
      "access": "rw",
      "limits": {
        "low": -5.0,
        "high": 5.0
      },
      "step_hint": 0.05,
      "settle": {
        "mode": "fixed_delay",
        "delay_sec": 0.5,
        "readback_tolerance": 0.01,
        "max_wait_sec": 3.0
      },
      "tags": [
        "orbit",
        "horizontal"
      ],
      "note": "Horizontal corrector for orbit response study"
    },
    {
      "id": "hc02_current",
      "name": "HC02",
      "group": "steering_x",
      "write_pv": "IRFEL:PS:HC02:current:ao",
      "readback_pv": "IRFEL:PS:HC02:current:ai",
      "unit": "A",
      "access": "rw",
      "limits": {
        "low": -5.0,
        "high": 5.0
      },
      "step_hint": 0.05,
      "settle": {
        "mode": "fixed_delay",
        "delay_sec": 0.5,
        "readback_tolerance": 0.01,
        "max_wait_sec": 3.0
      },
      "tags": [
        "orbit",
        "horizontal"
      ]
    },
    {
      "id": "vc01_current",
      "name": "VC01",
      "group": "steering_y",
      "write_pv": "IRFEL:PS:VC01:current:ao",
      "readback_pv": "IRFEL:PS:VC01:current:ai",
      "unit": "A",
      "access": "rw",
      "limits": {
        "low": -5.0,
        "high": 5.0
      },
      "step_hint": 0.05,
      "settle": {
        "mode": "fixed_delay",
        "delay_sec": 0.5,
        "readback_tolerance": 0.01,
        "max_wait_sec": 3.0
      },
      "tags": [
        "orbit",
        "vertical"
      ]
    },
    {
      "id": "ms01_current",
      "name": "MS01",
      "group": "solenoid",
      "write_pv": "IRFEL:PS:MS01:current:ao",
      "readback_pv": "IRFEL:PS:MS01:current:ai",
      "unit": "A",
      "access": "rw",
      "limits": {
        "low": 0.0,
        "high": 20.0
      },
      "step_hint": 0.1,
      "settle": {
        "mode": "readback_tolerance",
        "delay_sec": 0.3,
        "readback_tolerance": 0.02,
        "max_wait_sec": 5.0
      },
      "tags": [
        "focus",
        "solenoid"
      ]
    }
  ],
  "objects": [
    {
      "id": "ch2_asum",
      "name": "CH2 ASUM",
      "group": "ct",
      "read_pv": "IRFEL:BD:CT:CH2:WAV:ASUM",
      "unit": "a.u.",
      "precision": 3,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "charge",
        "ct"
      ]
    },
    {
      "id": "fel_energy",
      "name": "FEL Energy",
      "group": "radiation",
      "read_pv": "FEL:Energy",
      "unit": "uJ",
      "precision": 3,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "fel",
        "energy"
      ]
    },
    {
      "id": "ps1_waveform",
      "name": "PS1 Waveform",
      "group": "radiation",
      "read_pv": "IRFEL:PS1:WAVE",
      "unit": "V",
      "precision": 4,
      "kind": "waveform",
      "access": "ro",
      "capture_mode": "waveform",
      "waveform_sample_interval_sec": 2.5e-9,
      "value_reducer": "none",
      "analysis": {
        "jitter": false,
        "correlation": false,
        "spectrum": false
      },
      "tags": [
        "waveform",
        "power_source"
      ],
      "note": "Example raw waveform object for the Monitor Waveform analysis tab"
    },
    {
      "id": "bpm01_x",
      "name": "BPM01 X",
      "group": "bpm_x",
      "read_pv": "IRFEL-BI:BPM01:BPM_PX2",
      "unit": "mm",
      "precision": 4,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "bpm",
        "orbit",
        "horizontal"
      ]
    },
    {
      "id": "bpm02_x",
      "name": "BPM02 X",
      "group": "bpm_x",
      "read_pv": "IRFEL-BI:BPM02:BPM_PX2",
      "unit": "mm",
      "precision": 4,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "bpm",
        "orbit",
        "horizontal"
      ]
    },
    {
      "id": "bpm01_y",
      "name": "BPM01 Y",
      "group": "bpm_y",
      "read_pv": "IRFEL-BI:BPM01:BPM_PY2",
      "unit": "mm",
      "precision": 4,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "bpm",
        "orbit",
        "vertical"
      ]
    },
    {
      "id": "bpm02_y",
      "name": "BPM02 Y",
      "group": "bpm_y",
      "read_pv": "IRFEL-BI:BPM02:BPM_PY2",
      "unit": "mm",
      "precision": 4,
      "kind": "scalar",
      "access": "ro",
      "value_reducer": "none",
      "analysis": {
        "jitter": true,
        "correlation": true,
        "spectrum": true
      },
      "tags": [
        "bpm",
        "orbit",
        "vertical"
      ]
    }
  ],
  "presets": [
    {
      "id": "bpm_fast_jitter",
      "name": "BPM Fast Jitter",
      "mode": "timed_acquisition",
      "targets": [
        "bpm01_x",
        "bpm01_y",
        "bpm02_x",
        "bpm02_y",
        "fel_energy"
      ],
      "shot_interval_sec": 0.1,
      "sample_count": 500
    },
    {
      "id": "hc01_orbit_scan",
      "name": "HC01 Orbit Scan",
      "mode": "knob_scan",
      "knob_id": "hc01_current",
      "scan_values": [
        -0.2,
        -0.1,
        0.0,
        0.1,
        0.2
      ],
      "settle_delay_sec": 1.0,
      "sample_count_per_step": 20,
      "targets": [
        "bpm01_x",
        "bpm01_y",
        "bpm02_x",
        "bpm02_y",
        "fel_energy"
      ]
    }
  ]
}
