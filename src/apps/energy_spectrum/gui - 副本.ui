  <property name="styleSheet">
   <string notr="true">/* 全局基础：白色背景，深灰色文字 */
QMainWindow, QWidget {
    background-color: #ffffff;
    color: #2d3436;
    font-family: &quot;Segoe UI&quot;, &quot;PingFang SC&quot;, sans-serif;
}

/* 按钮：深蓝色系，在白底上非常醒目 */
QPushButton {
    background-color: #0984e3; /* 经典商务蓝 */
    border: none;
    border-radius: 4px;
    color: white;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #74b9ff;
}

QPushButton:pressed {
    background-color: #0a3d62;
}

/* 输入框：浅灰背景 + 蓝色下边框（现代简约感） */
QLineEdit {
    background-color: #f5f6fa;
    border: 1px solid #dfe6e9;
    border-bottom: 2px solid #0984e3; /* 底部强调色 */
    border-radius: 2px;
    padding: 3px;
    color: #2d3436;
}

QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #0984e3;
}

/* GroupBox：浅灰色描边，区分功能区 */
QGroupBox {
    background-color: #fdfdfd;
    border: 1px solid #dfe6e9;
    border-radius: 6px;
    margin-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #0984e3;
}

/* 标签加粗 */
QLabel {
    font-weight: bold;
    background-color: transparent;
}</string>
