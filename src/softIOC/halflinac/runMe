#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
BOOT_DIR="$APP_DIR/iocBoot/ioctarget"
ENV_PATHS="$BOOT_DIR/envPaths"

if [[ ! -f "$ENV_PATHS" ]]; then
  echo "Missing generated envPaths. Run scripts/configure_softioc.sh first." >&2
  exit 1
fi

EPICS_BASE="$(sed -n 's/^epicsEnvSet("EPICS_BASE","\(.*\)")$/\1/p' "$ENV_PATHS")"
if [[ -z "$EPICS_BASE" || ! -x "$EPICS_BASE/startup/EpicsHostArch" ]]; then
  echo "envPaths does not contain a usable EPICS_BASE: $ENV_PATHS" >&2
  exit 1
fi

HOST_ARCH="$("$EPICS_BASE/startup/EpicsHostArch")"
TARGET="$APP_DIR/bin/$HOST_ARCH/target"
if [[ ! -x "$TARGET" ]]; then
  echo "Missing IOC target for $HOST_ARCH. Rebuild with scripts/build_ioc.sh." >&2
  exit 1
fi

cd "$BOOT_DIR"
exec "$TARGET" st.cmd
