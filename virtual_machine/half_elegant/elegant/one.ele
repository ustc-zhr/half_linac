&run_setup
    lattice = lattice.lte,
    use_beamline = USEDLINE,
    combine_bunch_statistics = 0,
    default_order = 3,
    random_number_seed = 9876543210,
    p_central = 4298.710009972669,
    always_change_p0 = 1,
    tracking_updates = 1,
    centroid = %s.cen,
    bpm_centroid = %s.bpmcen,
&end

&run_control
    n_steps = 1,
    reset_rf_for_each_step = 1,
    restrict_fiducialization = 1,
&end

&twiss_output
    filename = %s.twi,
    matched = 0,
    beta_x = 39,
    beta_y = 39,
    alpha_x = 0.73,
    alpha_y = 0.73,
    concat_order = 1,
    statistics = 1,
&end

&matrix_output
    SDDS_output = %s.mat,
    individual_matrices = 0,
    full_matrix_only = 1,
&end

&sdds_beam
    input = pre.bun,
    center_arrival_time = 1,
    reuse_bunch = 1,
&end

&track &end