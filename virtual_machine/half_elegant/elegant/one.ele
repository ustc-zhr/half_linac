&run_setup
    lattice = lattice.lte,
    use_beamline = USEDLINE,
    combine_bunch_statistics = 0,
    default_order = 3,
    random_number_seed = 9876543210,
    p_central = 223.4028,
    always_change_p0 = 1,
    tracking_updates = 1,
    centroid = %s.cen,
    bpm_centroid = %s.bpmcen,
&end

&run_control
    n_steps = 1,
    reset_rf_for_each_step = 1,
    restrict_fiducialization = 1,
&end

&twiss_output
    filename = %s.twi,
    matched = 0,
    beta_x = 39,
    beta_y = 39,
    alpha_x = 0.73,
    alpha_y = 0.73,
    concat_order = 1,
    statistics = 1,
&end

&matrix_output
    SDDS_output = %s.mat,
    individual_matrices = 0,
    full_matrix_only = 1,
&end

&bunched_beam
    n_particles_per_bunch = 10000,
    emit_nx = 10e-6,
    emit_ny = 10e-6,
    use_twiss_command_values = 10000,
    distribution_type[0] = "gaussian",
    distribution_type[1] = "gaussian",
    distribution_type[2] = "gaussian",
    distribution_cutoff[0] = 5,
    distribution_cutoff[1] = 5,
    distribution_cutoff[2] = 5,
    sigma_s = 1.11e-3,
    sigma_dp = 4E-3,
&end

&track &end