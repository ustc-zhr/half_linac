% clear all;clc;close all
function latticeplot(filename,up_distance,height_scale)
    %% read
%     filename = 'one2.mag';
%     up_distance=1;
%     height_scale = 0.1;
    data = importdata(filename);
    data.data(:,2)=data.data(:,2)*height_scale+up_distance;

    data_SBEN = data.data(find(string(data.textdata(8:end,2))=='SBEN'),:);
    for i =1:size(data_SBEN,1)/7
        xpoint = data_SBEN((i-1)*7+1:i*7,1);
        ypoint = data_SBEN((i-1)*7+1:i*7,2)-(data_SBEN((i-1)*7+2,2)-up_distance)*0.45;
%         p1 = patch(xpoint,ypoint,'yellow','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'red');
    end
    
    data_CSBEN = data.data(find(string(data.textdata(8:end,2))=='CSBEND'),:);
    for i =1:size(data_CSBEN,1)/7
        xpoint = data_CSBEN((i-1)*7+1:i*7,1);
        ypoint = data_CSBEN((i-1)*7+1:i*7,2)-(data_CSBEN((i-1)*7+2,2)-up_distance)*0.45;
%         p1 = patch(xpoint,ypoint,'yellow','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'red');
    end
    
    data_CSRCSBEND = data.data(find(string(data.textdata(8:end,2))=='CSRCSBEND'),:);
    for i =1:size(data_CSRCSBEND,1)/7
        xpoint = data_CSRCSBEND((i-1)*7+1:i*7,1);
        ypoint = data_CSRCSBEND((i-1)*7+1:i*7,2)-(data_CSRCSBEND((i-1)*7+2,2)-up_distance)*0.45;
%         p1 = patch(xpoint,ypoint,'yellow','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'red');
    end
    
    data_QUAD = data.data(find(string(data.textdata(8:end,2))=='QUAD'),:);
    for i =1:size(data_QUAD,1)/6
        xpoint = data_QUAD((i-1)*6+1:i*6,1);
        ypoint = data_QUAD((i-1)*6+1:i*6,2);
%         p1 = patch(xpoint,ypoint,'yellow','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'yellow');
    end

    data_DRIFT = data.data(find(string(data.textdata(8:end,2))=='DRIF'),:);
    for i =1:size(data_DRIFT,1)/2
        xpoint = data_DRIFT((i-1)*2+1:i*2,1);
        ypoint = data_DRIFT((i-1)*2+1:i*2,2);
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'black');
    end
    
    data_CSRDRIF = data.data(find(string(data.textdata(8:end,2))=='CSRDRIFT'),:);
    for i =1:size(data_CSRDRIF,1)/2
        xpoint = data_CSRDRIF((i-1)*2+1:i*2,1);
        ypoint = data_CSRDRIF((i-1)*2+1:i*2,2);
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'black');
    end
    
    data_CSRDRIF = data.data(find(string(data.textdata(8:end,2))=='LSCDRIFT'),:);
    for i =1:size(data_CSRDRIF,1)/2
        xpoint = data_CSRDRIF((i-1)*2+1:i*2,1);
        ypoint = data_CSRDRIF((i-1)*2+1:i*2,2);
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'black');
    end
    
    data_RFCW = data.data(find(string(data.textdata(8:end,2))=='RFCW'),:);
    for i =1:size(data_RFCW,1)/10
        xpoint0 = data_RFCW([(i-1)*10+1,i*10],1);
        xpoint = [xpoint0;flip(xpoint0)];
        ypoint = 0.3*[height_scale,height_scale,-height_scale,-height_scale]+up_distance;
%         p1 = patch(xpoint,ypoint,'blue','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'cyan');
    end
    
    data_UND = data.data(find(string(data.textdata(8:end,2))=='EMATRIX'),:);
    for i =1:size(data_UND,1)/2
        xpoint = [data_UND((i-1)*2+1:i*2,1);flip(data_UND((i-1)*2+1:i*2,1))];
        ypoint = 0.3*[height_scale,height_scale,0.3*height_scale,0.3*height_scale]+up_distance;
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'blue');
        
        xpoint = [data_UND((i-1)*2+1:i*2,1);flip(data_UND((i-1)*2+1:i*2,1))];
        ypoint = 0.3*[-height_scale,-height_scale,-0.3*height_scale,-0.3*height_scale]+up_distance;
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'blue');
        
        xpoint = data_UND((i-1)*2+1:i*2,1);
        ypoint = data_UND((i-1)*2+1:i*2,2)*0+up_distance;
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'black');
    end
    
    data_MONI = data.data(find(string(data.textdata(8:end,2))=='MONI'),:);
    for i =1:size(data_MONI,1)/6
        xpoint = [data_MONI((i-1)*6+1:(i-1)*6+2,1))];
        ypoint = [-height_scale,]+up_distance;
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
        p1 = patch(xpoint,ypoint,'yellow');
        
%         xpoint = [data_MONI((i-1)*2+1:i*2,1);flip(data_MONI((i-1)*2+1:i*2,1))];
%         ypoint = 0.3*[-height_scale,-height_scale,-0.3*height_scale,-0.3*height_scale]+up_distance;
%         p1 = patch(xpoint,ypoint,'black','DisplayName','CAVITY');
%         p1 = patch(xpoint,ypoint,'blue');
        

%         p1 = patch(xpoint,ypoint,'black');
    end
    
    


end