%% cen
databeamzie = importdata('Cen.DAT');
figure
plot(databeamzie.data(:,1),1e3*databeamzie.data(:,2),databeamzie.data(:,1),1e3*databeamzie.data(:,3),'linewidth',2);set(gca,'fontname','arial','fontsize',16,'linewidth',2);xlabel('s (m)');ylabel('<x>/<y> (mm)');
legend('<x>','<y>','box','off')

% add lattice distribution
latticeplot('one.mag',-0.5,0.1)
legend('\sigma_x','\sigma_y','','box','off')
set(gcf,'unit','centimeters','position',[10 2 58 12]);
