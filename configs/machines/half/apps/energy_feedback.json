{
  "control_backends": ["real"],
  "real_status": "write_smoke_passed",
  "write_control": {
    "default": "blocked",
    "real": "allowed"
  },
  "measurement": {
    "id": "energy_spectrum",
    "kind": "energy_spectrum_target",
    "label": "Energy Spectrum",
    "capabilities": [
      "energy"
    ],
    "energy": {
      "element": "ENY",
      "channel": "energy_actual",
      "unit": "MeV"
    },
    "diagnostics": {},
    "valid_range_mev": [0, 2450],
    "median_window": 3
  },
  "default_measurement_source": "energy_spectrum",
  "measurement_alternatives": [
    {
      "id": "bpm21_22_23",
      "kind": "bpm_transport",
      "label": "BPM21/22/23",
      "capabilities": ["energy"],
      "bpm_elements": ["BPM21", "BPM22", "BPM23"],
      "plane": "x",
      "offset_mm": {
        "BPM21": 0.0,
        "BPM22": 0.0,
        "BPM23": 0.0
      },
      "reference_energy": {
        "element": "LINAC_ENERGY",
        "channel": "setpoint",
        "unit": "MeV"
      },
      "valid_range_mev": [0.0, 2450.0],
      "median_window": 3,
      "runtime": {
        "stale_timeout_s": 3.0,
        "max_bpm_timestamp_skew_s": 0.2
      },
      "model": {
        "quadrupole_strength_channel": "K1_total",
        "min_abs_r12_m": 1e-6,
        "min_abs_r16_m": 1e-6,
        "k1_abs_tolerance_per_m2": 1e-4,
        "k1_rel_tolerance": 1e-4,
        "zero_threshold_mm": 1e-6,
        "bend_assumption": "BH01 uses the fixed reference bend in the Elegant lattice"
      }
    }
  ],
  "pulse": {
    "marker": null,
    "require_marker_for_write": false
  },
  "control_groups": [
    {
      "id": "llrf18_llrf19_phase",
      "label": "LLRF18 / LLRF19 phase pair",
      "response_mev_per_knob_unit": -1.0,
      "loop_gain": 0.1,
      "max_knob_step": 0.3,
      "deadband_mev": 0.0,
      "action_window_mev": 5.0,
      "actuators": [
        {
          "id": "llrf18_phase",
          "label": "Phase 1 · LLRF18",
          "element": "LLRF18",
          "setpoint": "phase_set",
          "readback": "phase_readback",
          "coefficient": 1.0,
          "unit": "deg",
          "max_step": 0.3,
          "max_session_delta": 3.0,
          "verify_tolerance": 0.1,
          "cyclic_period": 360.0,
          "operating_range": [-180.0, 180.0]
        },
        {
          "id": "llrf19_phase",
          "label": "Phase 2 · LLRF19",
          "element": "LLRF19",
          "setpoint": "phase_set",
          "readback": "phase_readback",
          "coefficient": -1.081423,
          "unit": "deg",
          "max_step": 0.325,
          "max_session_delta": 3.0,
          "verify_tolerance": 0.1,
          "cyclic_period": 360.0,
          "operating_range": [-180.0, 180.0]
        }
      ]
    }
  ],
  "write_verification": {
    "timeout_s": 1.0,
    "poll_interval_s": 0.05,
    "command_precision": 2
  },
  "operator_controls": {
    "target": {
      "minimum": 0.0,
      "maximum": 2450.0,
      "decimals": 3
    },
    "gain": {
      "label": "ki",
      "minimum": 0.001,
      "maximum": 1.0,
      "decimals": 4
    },
    "actuator_ratio": {
      "label": "alpha",
      "actuator": "llrf19_phase",
      "sign": -1,
      "minimum": 0.001,
      "maximum": 10.0,
      "decimals": 6
    },
    "max_knob_step": {
      "label": "Step limit",
      "minimum": 0.01,
      "maximum": 5.0,
      "decimals": 3
    },
    "action_window": {
      "label": "Action window",
      "minimum": 0.1,
      "maximum": 100.0,
      "decimals": 3
    },
    "max_session_delta": {
      "label": "Session limit",
      "minimum": 0.1,
      "maximum": 30.0,
      "decimals": 3
    }
  },
  "runtime": {
    "sample_period_s": 1.0,
    "plot_period_s": 1.0,
    "connection_timeout_s": 2.0,
    "stale_timeout_s": 3.0,
    "max_history_points": 10000
  },
  "logging": {
    "file_prefix": "energy_feedback",
    "flush_every_n_rows": 1
  }
}
