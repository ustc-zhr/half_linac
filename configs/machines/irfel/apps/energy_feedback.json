      "a": 0.0,
      "b": 0.0,
      "response_q_mm_per_kv": 0.01,
      "fct_min": 1000,
      "q_action_range_mm": 3.0
    }
  },
  "default_measurement_source": "fir_bpm_dispersion",
  "measurement_alternatives": [],
  "pulse": {"marker": null, "require_marker_for_write": false},
